[Unit]
Description=Copy Klipper clipboard to XWayland for spice-vdagent
PartOf=graphical-session.target
After=graphical-session.target plasma-workspace.target

[Service]
Type=simple
ExecStart=%h/.local/bin/klipper-clipboard-sync
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
