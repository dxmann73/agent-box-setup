[Unit]
Description=BB local agent interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects
Environment=PATH=%h/.npm-global/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/snap/bin:/bin
ExecStart=%h/.local/bin/bb-app --server-bind-host 127.0.0.1 --server-port 38886
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
