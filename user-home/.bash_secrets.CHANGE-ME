# ~/.bash_secrets - API tokens and secrets (not tracked in version control)
#
# Setup:
#   1. Copy this file to user-home/.bash_secrets (same directory, gitignored)
#   2. Edit the copy with actual token values
#   3. Symlink it to home: ln -sfn ~/projects/agent-box-setup/user-home/.bash_secrets ~/.bash_secrets
#
# The .bash_secrets file is gitignored and must be mode 0600.

# Hugging Face token
export HF_TOKEN=your_huggingface_token_here

# Firecrawl from https://www.firecrawl.dev/app
export FIRECRAWL_API_KEY=fc-YOUR-API-KEY
